# Required for NB2, NB3, NB4
OPENAI_API_KEY=sk-your_key_here

# Optional for NB3 vector and hybrid arms.
# If absent, NB3 runs BM25-only and prints a clear skip note pointing at module 01.
# PINECONE_API_KEY=pcsk_your_key_here

# Defaults (override if you want a different judge or embedder)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
PINECONE_INDEX_NAME=rag-unpacked-intro
