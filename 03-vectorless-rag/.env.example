# Copy this file to .env and fill in your keys.
# .env is gitignored. Never commit real keys.

# --- OpenAI (NB3 only) ---
# Get a key from https://platform.openai.com/api-keys
# Required for NB3's answer-synthesis step. NB1 and NB2 don't need it.
OPENAI_API_KEY=sk-your_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Pinecone (NB3 head-to-head only, OPTIONAL) ---
# Only set this if you ran module 01 and have an existing index named
# 'rag-unpacked-intro'. Without it, NB3 still runs BM25 end-to-end and
# prints a note that the vector arm of the head-to-head is being skipped.
# PINECONE_API_KEY=pcsk_your_key_here
# PINECONE_INDEX_NAME=rag-unpacked-intro
# OPENAI_EMBED_MODEL=text-embedding-3-small
