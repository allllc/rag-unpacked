# Copy this file to .env and fill in your key.
# .env is gitignored. Never commit real keys.

# --- OpenAI ---
# Get a key from https://platform.openai.com/api-keys
# Only NB3 actually uses OpenAI. NB1 and NB2 only need Kuzu (no key needed).
OPENAI_API_KEY=sk-your_key_here

# Chat model used by NB3. Swap freely (gpt-4o, etc.).
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Kuzu ---
# No key required. Kuzu runs in-process. The database is stored on disk
# at data/movies.kuzu and is rebuilt by scripts/build_corpus.py if missing.

# --- Neo4j (optional) ---
# Only needed if you want to run NB3's Neo4j appendix against a real
# Neo4j instance. Get a free instance at https://console.neo4j.io/
# (Aura DB Free tier). The notebook ships the swap as code-as-text by default.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
